# Used by `npm run dev` (local development). docker compose sets its own values.
DATABASE_URL=postgres://subterfuge:subterfuge@localhost:5432/subterfuge
PORT=3000
HOST=127.0.0.1
# Set to true when served over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false
# Only when behind your own reverse proxy: true, or a comma-separated list of proxy IPs.
TRUST_PROXY=false
# When set, signing up requires this invite code. Leave empty for open sign-up.
REGISTRATION_CODE=
